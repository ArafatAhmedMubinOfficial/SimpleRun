{
  "name": "simpletun",
  "version": "1.0.0",
  "description": "Open-source clean-room clone of SimpliGen (simpligen.io) built and verified using REA (morluto/rea)",
  "type": "module",
  "license": "MIT",
  "main": "src/server/index.js",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "node --watch src/server/index.js",
    "electron": "electron electron/main.js",
    "mcp": "node packages/mcp-server/src/bin.js",
    "rea:analyze": "node scripts/fetch-and-analyze-rea.mjs",
    "rea:audit": "npx -y rea-agents@latest audit-release-exposure ./src --format json",
    "test": "node --test tests/*.test.js"
  },
  "optionalDependencies": {
    "electron": "^45.3.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "simpletun",
    "simpligen",
    "comfyui",
    "ai-generation",
    "video-studio",
    "character-studio",
    "mcp",
    "rea"
  ]
}
